{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "paths": {
            "@/lib/data-table-tanstack": [
                "./registry/react/lib/data-table-tanstack.ts"
            ],
            "@/lib/*": ["./registry/shared/lib/*"]
        }
    },
    "include": [
        "registry/react/lib/*.ts",
        "registry/shared/**/*.ts",
        "tests/e2e/*.ts",
        "playwright.config.ts",
        "vite.config.ts"
    ]
}
