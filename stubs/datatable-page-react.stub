import { Head } from '@inertiajs/react';
import { createColumnHelper } from '@tanstack/react-table';
{{ imports }}

/**
 * Rows only include the visible columns, so most fields are optional.
 */
type {{ rowType }} = {
    id: number;
{{ rowFields }}
};

type Props = {
    {{ prop }}: ServerDataTable<{{ rowType }}>;
};

const columnHelper = createColumnHelper<DataTableFeatures, {{ rowType }}>();

const columns = columnHelper.columns([
{{ columns }}
]);

export default function {{ component }}({ {{ prop }} }: Props) {
    const { table, isLoading } = useServerDataTable({
        table: {{ prop }},
        prop: '{{ prop }}',
        columns,
    });

    return (
        <>
            <Head title="{{ title }}" />
            <div className="flex h-full flex-1 flex-col gap-4 overflow-x-auto rounded-xl p-4">
                <DataTable
                    table={table}
                    aria-label="{{ title }}"
                    className={isLoading ? 'opacity-60' : undefined}
                >
                    <DataTableToolbar table={table} />
                </DataTable>
            </div>
        </>
    );
}

{{ component }}.layout = {
    breadcrumbs: [
        {
            title: '{{ title }}',
            href: '{{ url }}',
        },
    ],
};
